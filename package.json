{
  "name": "pptx-templates",
  "version": "0.1.2",
  "description": "A template based pptx generator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaBorsten/pptx-templates.git"
  },
  "author": "Boas Rautmann <boas.rautmann@gmail.com> (github.com/DaBorsten)",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "nodemon -e ts --exec 'ts-node' src/dev.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test-coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:visual": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.visual.config.ts",
    "docs:ai": "ts-node tools/ai-instructor/build.ts",
    "docs:api": "yarn --cwd website docusaurus generate-typedoc",
    "docs:start": "yarn --cwd website start",
    "docs:build": "yarn --cwd website build",
    "docs:serve": "yarn --cwd website serve",
    "validate:pptx": "node tools/fork/validate-pptx.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --config .prettierrc 'src/**/*.ts' --write"
  },
  "files": [
    "dist",
    "AI-INSTRUCTOR.md",
    "CHANGELOG.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "js-create-powerpoint",
    "js-create-pptx",
    "js-generate-powerpoint",
    "js-pptx",
    "js-produce-powerpoint",
    "js-powerpoint",
    "powerpoint",
    "powerpoint-charts",
    "powerpoint-presentation",
    "powerpoint-automation",
    "powerpoint-generator",
    "powerpoint-templates",
    "pptxgenjs-templates",
    "pptx",
    "presentations"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pixelmatch": "^7.1.0",
    "@types/pngjs": "^6.0.5",
    "@types/xmldom": "^0.1.34",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "pptx-thumbnailer": "0.1.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "jszip": "^3.10.2",
    "pptxgenjs": "^4.0.1",
    "regexp.escape": "^2.0.1",
    "slugify": "^1.6.9"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "resolutions": {
    "image-size": "^2.0.4",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
