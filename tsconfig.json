{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "strict": false,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "target": "es6",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["es2022"],
    "declaration": true,
    "declarationDir": "./dist",
    "types": ["jest", "node"],
    "useDefineForClassFields": false,
    "isolatedModules": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "__tests__/**/*",
    "__customer__/**/*",
    "docs",
    "src/dev.ts",
    "src/dev-*.ts"
  ]
}
